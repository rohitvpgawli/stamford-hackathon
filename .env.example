# Bootstrap inputs read by configure-production.mjs. Production runtime values
# are written to /home/ubuntu/.config/mango and are never committed here.
ANDROID_GATEWAY_BASE_URL=https://api.sms-gate.app/3rdparty/v1
ANDROID_GATEWAY_USERNAME=
ANDROID_GATEWAY_PASSWORD=
ANDROID_GATEWAY_DEVICE_ID=
ANDROID_GATEWAY_SIM_NUMBER=1
WEBHOOK_SHARED_SECRET=replace-with-at-least-32-random-characters

APP_ENV=demo
PORT=3001
DATABASE_URL=./data/mango.sqlite
PHONE_HASH_PEPPER=replace-with-a-long-random-secret
WEBHOOK_SHARED_SECRET=replace-with-provider-secret
ANDROID_GATEWAY_BASE_URL=https://api.sms-gate.app/3rdparty/v1
ANDROID_GATEWAY_USERNAME=
ANDROID_GATEWAY_PASSWORD=
ANDROID_GATEWAY_DEVICE_ID=
ANDROID_GATEWAY_SIM_NUMBER=1
# Mango's isolated Hermes profile listens on loopback by default.
HERMES_BASE_URL=http://127.0.0.1:8643
HERMES_API_KEY=replace-with-the-mango-profile-api-server-key
APP_DEEP_LINK_BASE_URL=http://localhost:3000
DEEP_LINK_SIGNING_SECRET=replace-with-a-long-random-secret
ADMIN_TOKEN=replace-with-an-admin-secret
MAX_USER_TURNS=12
TURN_WARNING_AT=10
SESSION_TTL_HOURS=12
INBOUND_MIN_INTERVAL_MS=2500
OUTBOUND_PER_MINUTE=20
INBOUND_BATCH=100
INBOUND_LEASE_MS=30000

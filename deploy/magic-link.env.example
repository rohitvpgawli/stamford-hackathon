# Separate protected environment file for mango-magic-link.service.
# Keep both gates false until staging acceptance and explicit production approval.
MANGO_PRODUCTION_ENABLED=false
WEB_MAGIC_LINK_READY=false
PORT=3002
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-server-secret-key
# Legacy SUPABASE_SERVICE_ROLE_KEY is also accepted if SUPABASE_SECRET_KEY is unset.
APP_URL=https://your-mango-app.example
MANGO_LOGIN_SECRET=replace-with-at-least-32-random-characters-shared-with-web
MANGO_OUTBOX_KEY=replace-with-base64-encoded-32-random-bytes
WEBHOOK_SHARED_SECRET=replace-with-at-least-32-random-characters
ADMIN_TOKEN=replace-with-at-least-32-random-characters
# Optional extra guard; existing device/SIM already selects the same Mango line.
# MANGO_RECEIVING_PHONE=+12035550123
ANDROID_GATEWAY_BASE_URL=https://api.sms-gate.app/3rdparty/v1
ANDROID_GATEWAY_USERNAME=replace-with-gateway-username
ANDROID_GATEWAY_PASSWORD=replace-with-gateway-password
ANDROID_GATEWAY_DEVICE_ID=replace-with-dedicated-mango-device-id
ANDROID_GATEWAY_SIM_NUMBER=1
# The installed service loads these from the protected hermes-production.env
# fragment generated by install-hermes-production.mjs, after this file.
# Placeholders below are for manual deployments only. See runbook.
HERMES_BASE_URL=http://127.0.0.1:8644
HERMES_API_KEY=replace-with-at-least-32-random-characters
